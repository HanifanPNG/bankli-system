---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bankli · Sistem Bank Sampah Mahasiswa",
  description = "Bankli membantu mahasiswa menyetorkan sampah di stand, mencatat nilai setoran, memantau saldo, dan mengajukan pencairan — dalam satu sistem.",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="h-full motion-safe:scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#00A15D" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="h-full font-sans text-strong">
		<slot />
	</body>
</html>
