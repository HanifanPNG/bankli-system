---
import SectionHeading from "../ui/SectionHeading.astro";

const categories = [
  {
    name: "Plastik, Botol & Tutup Botol",
    desc: "Botol air mineral, gelas plastik, tutup botol, dan kemasan plastik bersih yang sudah dipilah.",
    image: "/images/plastik.webp",
    imageAlt: "Tumpukan botol plastik bekas yang sudah dikumpulkan",
    imageWidth: 640,
    imageHeight: 360,
    media: "bg-brand-tint-soft",
    chips: ["Botol plastik", "Gelas plastik", "Tutup botol", "Kemasan plastik"],
  },
  {
    name: "Kardus & Kertas",
    desc: "Kardus bekas, kertas HVS, buku, dan kertas campuran yang masih kering dan bersih.",
    image: "/images/kardus.webp",
    imageAlt: "Tumpukan kardus dan kertas bekas di dalam karton",
    imageWidth: 612,
    imageHeight: 407,
    media: "bg-brand-kertas-tint",
    chips: ["Kardus", "Kertas HVS", "Buku", "Kertas campuran"],
  },
];
---

<section id="kategori" class="w-full px-6 py-[56px] lg:px-[120px] lg:py-[96px]">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-[26px] lg:gap-[46px]">
    <SectionHeading
      eyebrow="Kategori Sampah"
      title="Dua kategori, satu alur pencatatan."
      sub="Bankli menerima dua kelompok sampah. Pengurus memeriksa dan menimbang masing-masing kategori saat setoran di stand."
      class="mx-auto max-w-[780px]"
    />

    <div class="flex flex-col gap-[16px] lg:flex-row lg:gap-[24px]">
      {
        categories.map((category, categoryIndex) => (
          <article
            data-reveal="rise"
            data-reveal-delay={String(categoryIndex * 80)}
            class="flex flex-1 flex-col overflow-hidden rounded-[16px] border border-line bg-card lg:rounded-card-lg"
          >
            <div
              data-reveal="up"
              data-reveal-delay={String(categoryIndex * 80 + 240)}
              class:list={["h-[176px] overflow-hidden", category.media]}
            >
              <img
                src={category.image}
                alt={category.imageAlt}
                width={category.imageWidth}
                height={category.imageHeight}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>

            <div class="flex flex-col gap-[12px] p-[24px] lg:p-[24px_26px_26px_26px]">
              <h3 class="text-[18px] leading-[26px] font-semibold text-strong lg:text-[22px] lg:leading-[28px]">
                {category.name}
              </h3>
              <p class="text-[14px] leading-[22px] text-body lg:text-[15px] lg:leading-[23px]">{category.desc}</p>
              <ul class="flex flex-wrap gap-[8px] pt-[6px]">
                {category.chips.map((chip, chipIndex) => (
                  <li
                    data-reveal="up"
                    data-reveal-delay={String(categoryIndex * 80 + 160 + chipIndex * 40)}
                    class="rounded-[99px] border border-line-soft bg-chip px-[12px] py-[6px] text-[12.5px] font-medium text-label"
                  >
                    {chip}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
