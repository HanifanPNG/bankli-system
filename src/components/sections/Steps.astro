---
import Icon from "../Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const steps = [
  {
    title: "Bawa sampah",
    desc: "Bawa sampah yang sudah dipilah ke stand Bankli sesuai jadwal layanan.",
    icon: "footprints",
  },
  {
    title: "Ditimbang & dicatat",
    desc: "Pengurus memeriksa kategori, menimbang, lalu mencatat data setoran di sistem.",
    icon: "scale",
  },
  {
    title: "Nilai dihitung",
    desc: "Sistem menghitung nilai setoran dari berat dan harga per kilogram yang berlaku.",
    icon: "calculator",
  },
  {
    title: "Pantau saldo",
    desc: "Setoran yang sudah dikonfirmasi masuk ke saldo dan riwayat transaksimu.",
    icon: "wallet",
  },
  {
    title: "Ajukan pencairan",
    desc: "Ajukan pencairan tunai atau transfer DANA sesuai prosedur Bankli.",
    icon: "banknote",
  },
];
---

<section id="cara-kerja" class="w-full bg-page px-6 py-[56px] lg:px-[120px] lg:py-[96px]">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-[26px] lg:gap-[50px]">
    <SectionHeading
      eyebrow="Cara Kerja"
      title="Dari stand Bankli sampai saldo di aplikasimu."
      sub="Setoran tetap dicatat dan dikonfirmasi pengurus di stand. Kamu cukup memantau hasilnya lewat aplikasi."
      class="mx-auto max-w-[800px]"
    />

    <ol data-reveal-group class="flex flex-col gap-[16px] lg:flex-row lg:gap-[20px]">
      {
        steps.map((step, index) => (
          <li data-reveal="rise" class="flex flex-1 flex-col gap-[13px]">
            <div class="flex items-center gap-[12px]">
              <span class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-brand-dark text-[15px] font-bold text-white">
                {index + 1}
              </span>
              {index < steps.length - 1 && (
                <span data-reveal="grow" class="hidden h-px flex-1 bg-brand-border lg:block" />
              )}
            </div>
            <div class="flex items-center gap-[9px]">
              <Icon name={step.icon} class="h-[18px] w-[18px] shrink-0 text-brand-primary" />
              <h3 class="text-[16px] font-semibold text-strong">{step.title}</h3>
            </div>
            <p class="text-[13.5px] leading-[21px] text-body">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
