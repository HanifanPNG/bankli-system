---
import Icon from "../Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const options = [
  {
    title: "Tunai/Cash",
    desc: "Diambil langsung dari pengurus Bankli pada hari dan jam operasional stand.",
    tag: "Butuh pengurus",
    icon: "banknote",
  },
  {
    title: "Transfer DANA",
    desc: "Diajukan melalui aplikasi, lalu diproses manual oleh admin ke nomor DANA-mu.",
    tag: "Diproses admin",
    icon: "send",
  },
];
---

<section id="pencairan" class="w-full px-6 py-[56px] lg:px-[120px] lg:py-[96px]">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-[26px] lg:gap-[44px]">
    <SectionHeading
      eyebrow="Pencairan Saldo"
      title="Saldo dari setoran yang sudah dikonfirmasi."
      sub="Pantau saldo dan riwayat transaksimu, lalu ajukan pencairan sesuai kebutuhan. Pencairan mengikuti prosedur dan jadwal pelayanan Bankli."
      class="mx-auto max-w-[800px]"
    />

    <div data-reveal-group class="flex flex-col gap-[14px] lg:flex-row lg:gap-[24px]">
      {
        options.map((option) => (
          <article
            data-reveal="rise"
            class="flex flex-1 flex-col gap-[12px] rounded-[16px] border border-line bg-card p-[20px] lg:gap-[14px] lg:rounded-card-lg lg:p-[26px_26px_28px_26px]"
          >
            <div class="flex items-center justify-between gap-[10px]">
              <span class="flex h-[42px] w-[42px] items-center justify-center rounded-[12px] bg-brand-tint-soft lg:h-[46px] lg:w-[46px] lg:rounded-[13px]">
                <Icon name={option.icon} class="h-[21px] w-[21px] text-brand-primary lg:h-[23px] lg:w-[23px]" />
              </span>
              <span class="rounded-[99px] border border-line-soft bg-chip px-[11px] py-[5px] text-[11.5px] font-semibold text-label">
                {option.tag}
              </span>
            </div>
            <h3 class="text-[18px] font-semibold text-strong lg:text-[20px]">{option.title}</h3>
            <p class="text-[14px] leading-[22px] text-body lg:text-[15px] lg:leading-[23px]">{option.desc}</p>
          </article>
        ))
      }
    </div>

    <div
      data-reveal="up"
      data-reveal-delay="260"
      class="flex items-start gap-[10px] rounded-card bg-info-bg p-[16px_18px] lg:mx-auto lg:w-full lg:max-w-[800px]"
    >
      <Icon name="info" class="h-[17px] w-[17px] shrink-0 text-info-fg" />
      <p class="text-[13.5px] leading-[20px] font-medium text-info-text-dark">
        Pengajuan yang disetujui belum berarti sudah dibayar. Pencairan selesai setelah pembayaran
        dilakukan dan diverifikasi pengurus.
      </p>
    </div>
  </div>
</section>
