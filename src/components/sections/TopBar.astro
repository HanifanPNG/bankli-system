---
import Icon from "../Icon.astro";
---

<div class="w-full bg-brand-tint px-6 py-[10px] lg:px-[120px] lg:py-[11px]">
  <div class="mx-auto flex w-full max-w-[1200px] flex-wrap items-center justify-center gap-[8px] lg:gap-[10px]">
    <Icon name="recycle" class="h-[14px] w-[14px] shrink-0 text-brand-dark lg:h-[15px] lg:w-[15px]" />
    <p class="text-center text-[12.5px] font-medium text-brand-text-dark lg:hidden">
      Setor di stand Bankli, pantau saldo lewat aplikasi.
    </p>
    <p class="hidden text-center text-[13px] font-medium text-brand-text-dark lg:block">
      Ubah sampahmu jadi saldo — setor di stand Bankli, pantau lewat aplikasi.
    </p>
    <a
      href="#cara-kerja"
      class="hidden shrink-0 items-center gap-[5px] text-[13px] font-semibold text-brand-dark hover:underline lg:inline-flex"
    >
      Lihat cara kerja
      <Icon name="arrow-right" class="h-[14px] w-[14px]" />
    </a>
  </div>
</div>
